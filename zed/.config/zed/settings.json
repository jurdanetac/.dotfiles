// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "format_on_save": "on",
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "base_keymap": "Zed",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Gruvbox Dark",
  },
  "languages": {
    "Ruby": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "rubocop",
          "arguments": [
            "--auto-correct",
            "--stdin",
            "{buffer_path}",
            "--stderr",
          ],
        },
      },
    },
  },
}
